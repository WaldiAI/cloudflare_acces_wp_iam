{
  "name": "waldiai/cloudflare-access-wp-iam",
  "description": "WordPress IAM/SSO gateway using Cloudflare Access JWT, JIT provisioning, and IdP group-to-role mapping.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "7.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "IamLab\\CloudflareAccessWpIam\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "lint": "@php -l cloudflare-access-wp-iam.php && @php -l src/Plugin.php",
    "test": "phpunit"
  }
}
